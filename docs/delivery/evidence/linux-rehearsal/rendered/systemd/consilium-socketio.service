# Generated by the Consilium deployment kit from deploy/service/systemd/.
# The framework's realtime server (live list refresh and progress bars in open
# tabs). It is a Node.js program, and neither Node.js nor its libraries are in
# the offline bundle, so this unit is installed but not enabled, and does not
# start unless both exist. The product works without it; pages update on
# navigation instead of live.
[Unit]
Description=Consilium realtime server (optional; needs Node.js)
After=network-online.target
PartOf=consilium.target
ConditionPathExists=/opt/consilium/apps/frappe/socketio.js
ConditionPathExists=/opt/consilium/apps/frappe/node_modules/socket.io

[Service]
Type=simple
User=consilium
Group=consilium
WorkingDirectory=/opt/consilium
Environment=FRAPPE_BENCH_ROOT=/opt/consilium
ExecStart=/usr/bin/env node /opt/consilium/apps/frappe/socketio.js
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=consilium.target

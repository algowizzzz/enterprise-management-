# Generated by the Consilium deployment kit from deploy/service/systemd/.
# The application server: waitress, on the loopback interface only. The reverse
# proxy in front of it terminates TLS. It also serves /assets and /files itself,
# so the proxy needs no access to the installation directory.
[Unit]
Description=Consilium web server
Documentation=file:///opt/consilium/docs/ADMIN-GUIDE.md
After=network-online.target
Wants=network-online.target
PartOf=consilium.target

[Service]
Type=simple
User=consilium
Group=consilium
WorkingDirectory=/opt/consilium/sites
Environment=FRAPPE_BENCH_ROOT=/opt/consilium
Environment=XDG_CACHE_HOME=/opt/consilium/config/cache
Environment=PATH=/opt/consilium/env/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/consilium/env/bin/python -m winbench.cli serve --site governance.example.internal --host 127.0.0.1 --port 8000 --threads 8 --proxy
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
LimitNOFILE=65536
# Least privilege: no new privileges, a private /tmp, the OS read-only, home
# directories hidden, and write access only to the installation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/consilium

[Install]
WantedBy=consilium.target

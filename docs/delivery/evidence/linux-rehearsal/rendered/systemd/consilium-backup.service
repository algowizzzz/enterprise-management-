# Generated by the Consilium deployment kit from deploy/service/systemd/.
# One backup, run by consilium-backup.timer. Writes the database, uploaded
# files and site configuration to the backup directory and removes backups
# older than the retention period.
[Unit]
Description=Consilium backup
After=network-online.target

[Service]
Type=oneshot
User=consilium
Group=consilium
Environment=FRAPPE_BENCH_ROOT=/opt/consilium
Environment=XDG_CACHE_HOME=/opt/consilium/config/cache
Environment=PATH=/opt/consilium/env/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env python3 /opt/consilium/deploy/kit.py backup --config /etc/consilium/consilium.conf
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/consilium /var/backups/consilium

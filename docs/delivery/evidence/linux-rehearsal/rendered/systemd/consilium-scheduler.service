# Generated by the Consilium deployment kit from deploy/service/systemd/.
# The scheduler enqueues timed jobs: reviews falling due, reminders, service
# level sweeps, notification retries. Run EXACTLY ONE across the whole
# deployment: the framework's scheduler does not elect a leader, so a second
# one makes every scheduled job run twice. On a multi-server deployment enable
# this unit on one server only.
[Unit]
Description=Consilium scheduler (exactly one per deployment)
After=network-online.target
Wants=network-online.target
PartOf=consilium.target

[Service]
Type=simple
User=consilium
Group=consilium
WorkingDirectory=/opt/consilium/sites
Environment=FRAPPE_BENCH_ROOT=/opt/consilium
Environment=XDG_CACHE_HOME=/opt/consilium/config/cache
Environment=PATH=/opt/consilium/env/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/consilium/env/bin/python -m winbench.cli scheduler --site governance.example.internal
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/consilium

[Install]
WantedBy=consilium.target

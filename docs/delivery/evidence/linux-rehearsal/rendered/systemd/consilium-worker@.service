# Generated by the Consilium deployment kit from deploy/service/systemd/.
# One background worker per instance (consilium-worker@1, @2, ...). Workers run
# queued jobs: notifications, imports, exports. On Linux each job runs in a
# forked child, so a job that crashes or hangs is killed without taking the
# worker with it.
[Unit]
Description=Consilium background worker %i
After=network-online.target
Wants=network-online.target
PartOf=consilium.target

[Service]
Type=simple
User=consilium
Group=consilium
WorkingDirectory=/opt/consilium/sites
Environment=FRAPPE_BENCH_ROOT=/opt/consilium
Environment=XDG_CACHE_HOME=/opt/consilium/config/cache
Environment=PATH=/opt/consilium/env/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/consilium/env/bin/python -m winbench.cli worker --site governance.example.internal
Restart=always
RestartSec=5
# A job may be mid-way through; give it time to finish before it is killed.
TimeoutStopSec=120
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/consilium

[Install]
WantedBy=consilium.target

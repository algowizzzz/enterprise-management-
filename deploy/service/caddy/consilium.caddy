# Generated by the Consilium deployment kit from deploy/service/caddy/.
# TLS termination in front of the application server, for hosts that run
# Caddy rather than nginx. Import it from the main Caddyfile:
#
#     import /etc/caddy/consilium.caddy
#
# The certificate and key are given explicitly, so Caddy never tries to obtain
# one from a public certificate authority -- which would fail on a host with
# no internet access, and is not wanted on one that has it.

@HOSTNAME@:@HTTPS_PORT@ {
    tls @CERT_FILE@ @KEY_FILE@

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "same-origin"
    }

    request_body {
        max_size 50MB
    }

@IF_SOCKETIO@    reverse_proxy /socket.io/* 127.0.0.1:@SOCKETIO_PORT@

    reverse_proxy 127.0.0.1:@WEB_PORT@ {
        header_up X-Forwarded-Host {host}
        transport http {
            read_timeout 180s
        }
    }
}

http://@HOSTNAME@:@HTTP_PORT@ {
    redir https://{host}@HTTPS_PORT_SUFFIX@{uri} permanent
}

# Generated by the Consilium deployment kit from deploy/service/systemd/.
# One backup, run by consilium-backup.timer. Writes the database, uploaded
# files and site configuration to the backup directory and removes backups
# older than the retention period.
[Unit]
Description=Consilium backup
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
Environment=FRAPPE_BENCH_ROOT=@INSTALL_DIR@
Environment=XDG_CACHE_HOME=@INSTALL_DIR@/config/cache
Environment=PATH=@INSTALL_DIR@/env/bin:@EXTRA_PATH@/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env python3 @INSTALL_DIR@/deploy/kit.py backup --config @CONFIG@
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=@INSTALL_DIR@ @BACKUP_DIR@

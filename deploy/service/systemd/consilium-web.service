# Generated by the Consilium deployment kit from deploy/service/systemd/.
# The application server: waitress, on the loopback interface only. The reverse
# proxy in front of it terminates TLS. It also serves /assets and /files itself,
# so the proxy needs no access to the installation directory.
[Unit]
Description=Consilium web server
Documentation=file://@INSTALL_DIR@/docs/ADMIN-GUIDE.md
After=network-online.target
Wants=network-online.target
PartOf=consilium.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@/sites
Environment=FRAPPE_BENCH_ROOT=@INSTALL_DIR@
Environment=XDG_CACHE_HOME=@INSTALL_DIR@/config/cache
Environment=PATH=@INSTALL_DIR@/env/bin:@EXTRA_PATH@/usr/local/bin:/usr/bin:/bin
ExecStart=@INSTALL_DIR@/env/bin/python -m winbench.cli serve --site @SITE@ --host 127.0.0.1 --port @WEB_PORT@ --threads @THREADS@ --proxy
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
LimitNOFILE=65536
# Least privilege: no new privileges, a private /tmp, the OS read-only, home
# directories hidden, and write access only to the installation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=@INSTALL_DIR@

[Install]
WantedBy=consilium.target

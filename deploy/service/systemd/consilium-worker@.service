# Generated by the Consilium deployment kit from deploy/service/systemd/.
# One background worker per instance (consilium-worker@1, @2, ...). Workers run
# queued jobs: notifications, imports, exports. On Linux each job runs in a
# forked child, so a job that crashes or hangs is killed without taking the
# worker with it.
[Unit]
Description=Consilium background worker %i
After=network-online.target
Wants=network-online.target
PartOf=consilium.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@/sites
Environment=FRAPPE_BENCH_ROOT=@INSTALL_DIR@
Environment=XDG_CACHE_HOME=@INSTALL_DIR@/config/cache
Environment=PATH=@INSTALL_DIR@/env/bin:@EXTRA_PATH@/usr/local/bin:/usr/bin:/bin
ExecStart=@INSTALL_DIR@/env/bin/python -m winbench.cli worker --site @SITE@
Restart=always
RestartSec=5
# A job may be mid-way through; give it time to finish before it is killed.
TimeoutStopSec=120
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=@INSTALL_DIR@

[Install]
WantedBy=consilium.target

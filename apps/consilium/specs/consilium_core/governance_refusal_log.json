{
  "name": "Governance Refusal Log",
  "module": "Consilium Core",
  "description": "Every refusal a Core control issued: what was attempted, on which record, why it was refused, by whom and when. Written on an out-of-band connection so that the refusal survives the rollback of the operation it refused. Append-only.",
  "allow_rename": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "subject_doctype",
      "fieldtype": "Link",
      "label": "Refused Record DocType",
      "options": "DocType",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "subject_name",
      "fieldtype": "Dynamic Link",
      "label": "Refused Record",
      "options": "subject_doctype",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "attempted_action",
      "fieldtype": "Select",
      "label": "Attempted Action",
      "reqd": 1,
      "options": "Modify\nDelete\nDispose\nRevert\nOther",
      "in_standard_filter": 1
    },
    {
      "fieldname": "control",
      "fieldtype": "Data",
      "label": "Control",
      "reqd": 1,
      "description": "Which Core control refused: retention, legal hold, append-only, rule set lock."
    },
    {
      "fieldname": "refusal_reason",
      "fieldtype": "Text",
      "label": "Refusal Reason",
      "reqd": 1
    },
    {
      "fieldname": "refused_on",
      "fieldtype": "Datetime",
      "label": "Refused On",
      "reqd": 1
    },
    {
      "fieldname": "refused_for",
      "fieldtype": "Link",
      "label": "Refused For",
      "options": "User",
      "reqd": 1,
      "description": "The user whose action was refused."
    },
    {
      "fieldname": "retention_class",
      "fieldtype": "Link",
      "label": "Retention Class",
      "options": "Retention Class"
    },
    {
      "fieldname": "legal_hold",
      "fieldtype": "Link",
      "label": "Legal Hold",
      "options": "Legal Hold"
    },
    {
      "fieldname": "context",
      "fieldtype": "JSON",
      "label": "Context"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Records Manager",
      "read": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "GREF-.#####",
  "naming_rule": "Expression (old style)"
}

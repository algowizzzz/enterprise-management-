{
  "name": "External System",
  "module": "Consilium Core",
  "description": "A system this platform exchanges files with. Holds a URL pattern so a stored foreign key can be rendered as a link without the platform calling anything.",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "system_code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "reference_url_pattern",
      "fieldtype": "Data",
      "label": "Reference URL Pattern",
      "description": "A pattern containing {key}. Rendered for display only; never fetched."
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "field:system_code",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title,system_code"
}

{
  "name": "Risk Category",
  "module": "Consilium Core",
  "description": "The enterprise risk taxonomy. A tree so that tier 1 categories can carry sub-categories.",
  "autoname": "field:risk_category_code",
  "allow_rename": 1,
  "title_field": "risk_category_name",
  "search_fields": "risk_category_name,risk_category_code",
  "sort_field": "risk_category_name",
  "sort_order": "ASC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "risk_category_code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1,
      "description": "Stable identifier. Used by integrations and imports; do not reuse a retired code."
    },
    {
      "fieldname": "risk_category_name",
      "fieldtype": "Data",
      "label": "Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1,
      "description": "Inactive values stay on historical records but are not offered for new ones."
    },
    {
      "fieldname": "parent_risk_category",
      "fieldtype": "Link",
      "label": "Parent",
      "options": "Risk Category",
      "ignore_user_permissions": 1
    },
    {
      "fieldname": "is_group",
      "fieldtype": "Check",
      "label": "Is Group",
      "default": "0"
    },
    {
      "fieldname": "lft",
      "fieldtype": "Int",
      "label": "lft",
      "hidden": 1,
      "no_copy": 1,
      "print_hide": 1
    },
    {
      "fieldname": "rgt",
      "fieldtype": "Int",
      "label": "rgt",
      "hidden": 1,
      "no_copy": 1,
      "print_hide": 1
    },
    {
      "fieldname": "old_parent",
      "fieldtype": "Link",
      "label": "Old Parent",
      "options": "Risk Category",
      "hidden": 1,
      "no_copy": 1,
      "print_hide": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Taxonomy Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ],
  "is_tree": 1,
  "nsm_parent_field": "parent_risk_category"
}

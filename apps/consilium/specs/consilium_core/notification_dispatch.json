{
  "name": "Notification Dispatch",
  "module": "Consilium Core",
  "description": "Evidence that a party was notified. Recorded because several requirements need proof of notification, and an email queue that prunes itself is not evidence.",
  "allow_rename": 0,
  "track_changes": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "subject_doctype",
      "fieldtype": "Link",
      "label": "Subject Record DocType",
      "options": "DocType",
      "reqd": 0,
      "in_standard_filter": 1
    },
    {
      "fieldname": "subject_name",
      "fieldtype": "Dynamic Link",
      "label": "Subject Record",
      "options": "subject_doctype",
      "reqd": 0,
      "in_standard_filter": 1
    },
    {
      "fieldname": "notification_definition",
      "fieldtype": "Link",
      "label": "Notification Definition",
      "options": "Notification"
    },
    {
      "fieldname": "channel",
      "fieldtype": "Link",
      "label": "Channel",
      "options": "Notification Channel",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "recipient",
      "fieldtype": "Link",
      "label": "Recipient",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "rendered_subject",
      "fieldtype": "Data",
      "label": "Subject",
      "in_list_view": 1
    },
    {
      "fieldname": "rendered_body",
      "fieldtype": "Long Text",
      "label": "Body"
    },
    {
      "fieldname": "queued_on",
      "fieldtype": "Datetime",
      "label": "Queued On",
      "reqd": 1
    },
    {
      "fieldname": "sent_on",
      "fieldtype": "Datetime",
      "label": "Sent On"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Queued",
      "in_list_view": 1,
      "options": "Queued\nSent\nFailed\nSuppressed"
    },
    {
      "fieldname": "is_open",
      "fieldtype": "Check",
      "label": "Is Open",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag derived from Workflow State Flag. Retry reads this, never the status string."
    },
    {
      "fieldname": "failure_reason",
      "fieldtype": "Text",
      "label": "Failure Reason"
    },
    {
      "fieldname": "retry_count",
      "fieldtype": "Int",
      "label": "Retries",
      "default": "0"
    },
    {
      "fieldname": "fallback_of",
      "fieldtype": "Link",
      "label": "Fallback Of",
      "options": "Notification Dispatch",
      "description": "Set on the dispatch raised because this one's predecessor failed."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "NDSP-.#####",
  "naming_rule": "Expression (old style)"
}

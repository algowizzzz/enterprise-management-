{
  "name": "Attestation Task",
  "module": "Consilium Core",
  "description": "One row per campaign, participant and record. Standalone, not a child, so a participant's task list is a first-class query and tasks survive campaign edits.",
  "allow_rename": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "subject_doctype",
      "fieldtype": "Link",
      "label": "Attested Record DocType",
      "options": "DocType",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "subject_name",
      "fieldtype": "Dynamic Link",
      "label": "Attested Record",
      "options": "subject_doctype",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "campaign",
      "fieldtype": "Link",
      "label": "Campaign",
      "options": "Attestation Campaign",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "assigned_to",
      "fieldtype": "Link",
      "label": "Assigned To",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "assigned_role",
      "fieldtype": "Link",
      "label": "Assigned Seat Role",
      "options": "Governance Forum Role",
      "description": "Which seat made this person a participant. Empty for document attestation."
    },
    {
      "fieldname": "second_signatory",
      "fieldtype": "Link",
      "label": "Second Signatory",
      "options": "User",
      "description": "Required when the campaign requires dual signature."
    },
    {
      "fieldname": "due_on",
      "fieldtype": "Date",
      "label": "Due On",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Copied from the campaign so that a per-task extension is possible."
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Pending",
      "in_list_view": 1,
      "options": "Pending\nIn Progress\nAttested\nAttested With Exceptions\nDeclined\nExpired",
      "description": "A label. Regeneration and reporting read is_open, never this string."
    },
    {
      "fieldname": "is_open",
      "fieldtype": "Check",
      "label": "Is Open",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag derived from Workflow State Flag. An open task is never duplicated by regeneration."
    },
    {
      "fieldname": "is_editable",
      "fieldtype": "Check",
      "label": "Is Editable",
      "read_only": 1,
      "default": "1"
    },
    {
      "fieldname": "requires_review",
      "fieldtype": "Check",
      "label": "Requires Review",
      "read_only": 1
    },
    {
      "fieldname": "requires_statement",
      "fieldtype": "Check",
      "label": "Requires Statement",
      "read_only": 1,
      "description": "Semantic flag derived from Workflow State Flag. Validation reads this, never the status label."
    },
    {
      "fieldname": "responded_on",
      "fieldtype": "Datetime",
      "label": "Responded On",
      "read_only": 1
    },
    {
      "fieldname": "response_statement",
      "fieldtype": "Text",
      "label": "Response Statement",
      "description": "Required when the response is with exceptions or declined."
    },
    {
      "fieldname": "second_signed_on",
      "fieldtype": "Datetime",
      "label": "Second Signed On",
      "read_only": 1
    },
    {
      "fieldname": "acting_delegation",
      "fieldtype": "Link",
      "label": "Acting Delegation",
      "options": "Authority Delegation",
      "description": "Set when a delegate responded. Preserves who was actually accountable."
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "Attestation Task Item"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "ATSK-.#####",
  "naming_rule": "Expression (old style)",
  "search_fields": "campaign,assigned_to",
  "provenance": "02-data-model.md \u00a75.1"
}

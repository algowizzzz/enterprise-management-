{
  "name": "Import Field Mapping",
  "module": "Consilium Core",
  "description": "One source column mapped onto one target field, with its transform and its handling.",
  "allow_rename": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "source_column",
      "fieldtype": "Data",
      "label": "Source Column",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "target_fieldname",
      "fieldtype": "Data",
      "label": "Target Fieldname",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "transform",
      "fieldtype": "Select",
      "label": "Transform",
      "reqd": 1,
      "default": "None",
      "options": "None\nTrim\nUpper\nDate Parse\nLookup",
      "in_list_view": 1
    },
    {
      "fieldname": "lookup_doctype",
      "fieldtype": "Link",
      "label": "Lookup DocType",
      "options": "DocType",
      "depends_on": "eval:doc.transform=='Lookup'"
    },
    {
      "fieldname": "lookup_field",
      "fieldtype": "Data",
      "label": "Lookup Field",
      "depends_on": "eval:doc.transform=='Lookup'"
    },
    {
      "fieldname": "is_required",
      "fieldtype": "Check",
      "label": "Required"
    },
    {
      "fieldname": "default_value",
      "fieldtype": "Data",
      "label": "Default Value"
    }
  ],
  "permissions": [],
  "istable": 1
}

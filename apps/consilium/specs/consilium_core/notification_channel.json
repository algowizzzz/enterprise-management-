{
  "name": "Notification Channel",
  "module": "Consilium Core",
  "description": "A delivery channel and its adapter, so a channel can be introduced without touching a notification definition.",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "channel_code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "channel_type",
      "fieldtype": "Select",
      "label": "Channel Type",
      "reqd": 1,
      "default": "In App",
      "options": "Email\nIn App\nChat\nWebhook\nDigest",
      "in_list_view": 1
    },
    {
      "fieldname": "adapter",
      "fieldtype": "Data",
      "label": "Adapter",
      "reqd": 1,
      "description": "The registered handler name. Resolved from the adapter registry; never imported by path from data."
    },
    {
      "fieldname": "configuration",
      "fieldtype": "JSON",
      "label": "Configuration"
    },
    {
      "fieldname": "fallback_channel",
      "fieldtype": "Link",
      "label": "Fallback Channel",
      "options": "Notification Channel",
      "description": "Used when this channel fails. A chain may not contain a cycle."
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "field:channel_code",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title,channel_code",
  "provenance": "02-data-model.md \u00a75.7"
}

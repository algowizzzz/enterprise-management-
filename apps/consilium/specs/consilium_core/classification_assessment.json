{
  "name": "Classification Assessment",
  "module": "Consilium Core",
  "description": "The immutable record of one evaluation: the answers given, the rule that fired, the outcome and the full trace of every rule considered. Append-only.",
  "allow_rename": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "subject_doctype",
      "fieldtype": "Link",
      "label": "Assessed Record DocType",
      "options": "DocType",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "subject_name",
      "fieldtype": "Dynamic Link",
      "label": "Assessed Record",
      "options": "subject_doctype",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "rule_set",
      "fieldtype": "Link",
      "label": "Rule Set",
      "options": "Classification Rule Set",
      "reqd": 1
    },
    {
      "fieldname": "rule_set_version_label",
      "fieldtype": "Data",
      "label": "Rule Set Version",
      "reqd": 1,
      "description": "Copied, not joined: the rule set may later be superseded, and a past decision must stay explicable."
    },
    {
      "fieldname": "matched_rule_code",
      "fieldtype": "Data",
      "label": "Matched Rule",
      "description": "Empty when the default outcome applied."
    },
    {
      "fieldname": "outcome",
      "fieldtype": "Data",
      "label": "Outcome",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "outcome_rationale",
      "fieldtype": "Text",
      "label": "Outcome Rationale",
      "reqd": 1
    },
    {
      "fieldname": "evaluation_trace",
      "fieldtype": "JSON",
      "label": "Evaluation Trace",
      "reqd": 1,
      "description": "Every rule considered and why it did or did not match. Stored, never recomputed."
    },
    {
      "fieldname": "evaluated_on",
      "fieldtype": "Datetime",
      "label": "Evaluated On",
      "reqd": 1
    },
    {
      "fieldname": "evaluated_by",
      "fieldtype": "Link",
      "label": "Evaluated By",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "overridden",
      "fieldtype": "Check",
      "label": "Overridden",
      "default": "0"
    },
    {
      "fieldname": "override_outcome",
      "fieldtype": "Data",
      "label": "Override Outcome",
      "depends_on": "overridden"
    },
    {
      "fieldname": "override_justification",
      "fieldtype": "Text",
      "label": "Override Justification",
      "depends_on": "overridden",
      "description": "Required when overridden."
    },
    {
      "fieldname": "override_approved_by",
      "fieldtype": "Link",
      "label": "Override Approved By",
      "options": "User",
      "depends_on": "overridden"
    },
    {
      "fieldname": "answers",
      "fieldtype": "Table",
      "label": "Answers",
      "options": "Classification Assessment Answer"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "CASS-.#####",
  "naming_rule": "Expression (old style)",
  "provenance": "02-data-model.md \u00a75.2"
}

{
  "name": "Legal Entity",
  "module": "Consilium Core",
  "description": "Legal entities within the group. A tree, because entities sit under one another (02-data-model.md T-1 marks it hierarchical).",
  "autoname": "field:legal_entity_code",
  "allow_rename": 1,
  "title_field": "legal_entity_name",
  "search_fields": "legal_entity_name,legal_entity_code",
  "sort_field": "legal_entity_name",
  "sort_order": "ASC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "legal_entity_code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1,
      "description": "Stable identifier. Used by integrations and imports; do not reuse a retired code."
    },
    {
      "fieldname": "legal_entity_name",
      "fieldtype": "Data",
      "label": "Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1,
      "description": "Inactive values stay on historical records but are not offered for new ones."
    },
    {
      "fieldname": "sort_order",
      "fieldtype": "Int",
      "label": "Sort Order",
      "description": "Presentation order where alphabetical is wrong."
    },
    {
      "fieldname": "external_code",
      "fieldtype": "Data",
      "label": "External Code",
      "description": "The identifier this value carries in whatever system of record eventually owns it. Reserved now so a future reconciliation needs no migration. [Inferred \u2014 02-data-model.md \u00a711 I-2.]"
    },
    {
      "fieldname": "parent_legal_entity",
      "fieldtype": "Link",
      "label": "Parent",
      "options": "Legal Entity",
      "ignore_user_permissions": 1
    },
    {
      "fieldname": "is_group",
      "fieldtype": "Check",
      "label": "Is Group",
      "default": "0"
    },
    {
      "fieldname": "lft",
      "fieldtype": "Int",
      "label": "lft",
      "hidden": 1,
      "no_copy": 1,
      "print_hide": 1
    },
    {
      "fieldname": "rgt",
      "fieldtype": "Int",
      "label": "rgt",
      "hidden": 1,
      "no_copy": 1,
      "print_hide": 1
    },
    {
      "fieldname": "old_parent",
      "fieldtype": "Link",
      "label": "Old Parent",
      "options": "Legal Entity",
      "hidden": 1,
      "no_copy": 1,
      "print_hide": 1
    },
    {
      "fieldname": "is_material_entity",
      "fieldtype": "Check",
      "label": "Material Entity",
      "default": "0"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Taxonomy Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ],
  "allow_import": 1,
  "is_tree": 1,
  "nsm_parent_field": "parent_legal_entity"
}

{
  "name": "Guide Article",
  "module": "Consilium Core",
  "description": "The home-page user guide, editable without a deployment. Files are attached through the framework's own attachment mechanism rather than a field.",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "slug",
      "fieldtype": "Data",
      "label": "Slug",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "fieldtype": "Select",
      "label": "Category",
      "reqd": 1,
      "default": "Getting Started",
      "in_list_view": 1,
      "options": "Getting Started\nForum Types\nTemplates\nDecision Authority\nEscalation Protocol\nPolicy Lifecycle"
    },
    {
      "fieldname": "applies_to_module",
      "fieldtype": "Select",
      "label": "Applies To Module",
      "reqd": 1,
      "default": "All",
      "options": "All\nCore\nGovernance\nPolicy\nEscalation"
    },
    {
      "fieldname": "body",
      "fieldtype": "Text Editor",
      "label": "Body"
    },
    {
      "fieldname": "display_order",
      "fieldtype": "Int",
      "label": "Display Order"
    },
    {
      "fieldname": "is_published",
      "fieldtype": "Check",
      "label": "Published",
      "default": "0",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ],
  "autoname": "field:slug",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title,slug",
  "provenance": "02-data-model.md \u00a75.11"
}

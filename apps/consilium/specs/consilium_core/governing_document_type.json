{
  "name": "Governing Document Type",
  "module": "Consilium Core",
  "description": "Policy, standard, procedure, guideline and so on.",
  "autoname": "field:document_type_code",
  "allow_rename": 1,
  "title_field": "document_type_name",
  "search_fields": "document_type_name,document_type_code",
  "sort_field": "document_type_name",
  "sort_order": "ASC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "document_type_code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1,
      "description": "Stable identifier. Used by integrations and imports; do not reuse a retired code."
    },
    {
      "fieldname": "document_type_name",
      "fieldtype": "Data",
      "label": "Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1,
      "description": "Inactive values stay on historical records but are not offered for new ones."
    },
    {
      "fieldname": "requires_committee_approval",
      "fieldtype": "Check",
      "label": "Requires Committee Approval",
      "default": "0"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Taxonomy Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ]
}

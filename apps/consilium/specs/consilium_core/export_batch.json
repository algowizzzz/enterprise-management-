{
  "name": "Export Batch",
  "module": "Consilium Core",
  "description": "One generated outbound file, with its hash and the filter that produced it.",
  "allow_rename": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "export_profile",
      "fieldtype": "Data",
      "label": "Export Profile",
      "reqd": 1,
      "description": "The model names an export_profile field but defines no entity for it; it is a label here."
    },
    {
      "fieldname": "target_system",
      "fieldtype": "Link",
      "label": "Target System",
      "options": "External System",
      "reqd": 1
    },
    {
      "fieldname": "source_doctype",
      "fieldtype": "Link",
      "label": "Source DocType",
      "options": "DocType",
      "reqd": 1
    },
    {
      "fieldname": "generated_on",
      "fieldtype": "Datetime",
      "label": "Generated On",
      "reqd": 1
    },
    {
      "fieldname": "generated_by",
      "fieldtype": "Link",
      "label": "Generated By",
      "options": "User"
    },
    {
      "fieldname": "record_count",
      "fieldtype": "Int",
      "label": "Records",
      "read_only": 1
    },
    {
      "fieldname": "output_file",
      "fieldtype": "Attach",
      "label": "Output File"
    },
    {
      "fieldname": "output_sha256",
      "fieldtype": "Data",
      "label": "Output SHA-256"
    },
    {
      "fieldname": "export_filter",
      "fieldtype": "JSON",
      "label": "Filter"
    },
    {
      "fieldname": "file_format",
      "fieldtype": "Data",
      "label": "Format",
      "read_only": 1
    },
    {
      "fieldname": "record_names",
      "fieldtype": "JSON",
      "label": "Records Exported",
      "read_only": 1,
      "description": "The identifier of every record in the file, in file order: the linkage register that lets a reply from the receiving system be traced back."
    },
    {
      "fieldname": "excluded_count",
      "fieldtype": "Int",
      "label": "Left Out As Restricted",
      "read_only": 1
    },
    {
      "fieldname": "capped",
      "fieldtype": "Check",
      "label": "Reached The Row Limit",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "delivered_to",
      "fieldtype": "Data",
      "label": "Delivered To",
      "read_only": 1,
      "length": 500,
      "description": "Downloaded by the person who ran it, or the drop folder a scheduled run wrote to."
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Generated",
      "options": "Generated\nDelivered\nFailed\nCancelled"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "EXPB-.#####",
  "naming_rule": "Expression (old style)"
}

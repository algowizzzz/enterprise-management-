{
  "name": "SLA Definition",
  "module": "Consilium Core",
  "description": "An agreed time target for a workflow step, a status duration or total time open, with a warning threshold. The framework supplies none of this.",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "sla_code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "target_doctype",
      "fieldtype": "Link",
      "label": "Target DocType",
      "options": "DocType",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "applies_when",
      "fieldtype": "JSON",
      "label": "Applies When"
    },
    {
      "fieldname": "measure",
      "fieldtype": "Select",
      "label": "Measure",
      "reqd": 1,
      "default": "Total Open Time",
      "options": "Time In State\nTime To First Action\nTotal Open Time\nTime To Close",
      "in_list_view": 1
    },
    {
      "fieldname": "state_field",
      "fieldtype": "Data",
      "label": "State Field",
      "description": "Configuration for the Time In State measure. The value below is compared against this field's contents; neither is a literal in code."
    },
    {
      "fieldname": "state_value",
      "fieldtype": "Data",
      "label": "State Value"
    },
    {
      "fieldname": "target_hours",
      "fieldtype": "Float",
      "label": "Target Hours",
      "reqd": 1
    },
    {
      "fieldname": "warning_threshold_pct",
      "fieldtype": "Int",
      "label": "Warning Threshold %",
      "default": "80"
    },
    {
      "fieldname": "calendar",
      "fieldtype": "Select",
      "label": "Calendar",
      "reqd": 1,
      "default": "24x7",
      "options": "24x7\nBusiness Hours"
    },
    {
      "fieldname": "business_calendar",
      "fieldtype": "Link",
      "label": "Business Calendar",
      "options": "Business Calendar",
      "depends_on": "eval:doc.calendar=='Business Hours'"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "field:sla_code",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title,sla_code",
  "provenance": "02-data-model.md \u00a75.8"
}

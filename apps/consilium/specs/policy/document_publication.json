{
  "name": "Document Publication",
  "module": "Policy",
  "description": "The act of publishing one version to a stated audience, with the renditions allowed and the evidence that the affected parties were notified.",
  "autoname": "PPUB-.#####",
  "naming_rule": "Expression (old style)",
  "search_fields": "document,document_version",
  "fields": [
    {
      "fieldname": "document",
      "fieldtype": "Link",
      "label": "Document",
      "options": "Governing Document",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "document_version",
      "fieldtype": "Link",
      "label": "Document Version",
      "options": "Document Version",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "published_on",
      "fieldtype": "Datetime",
      "label": "Published On",
      "read_only": 1
    },
    {
      "fieldname": "published_by",
      "fieldtype": "Link",
      "label": "Published By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "audience_type",
      "fieldtype": "Select",
      "label": "Audience",
      "reqd": 1,
      "default": "All Employees",
      "in_list_view": 1,
      "options": "All Employees\nRestricted\nTargeted Groups"
    },
    {
      "fieldname": "audiences",
      "fieldtype": "Table",
      "label": "Audiences",
      "options": "Publication Audience"
    },
    {
      "fieldname": "rendition_view_only",
      "fieldtype": "Check",
      "label": "View Only",
      "default": "0"
    },
    {
      "fieldname": "rendition_print",
      "fieldtype": "Check",
      "label": "Printable",
      "default": "1"
    },
    {
      "fieldname": "rendition_download",
      "fieldtype": "Check",
      "label": "Downloadable",
      "default": "1"
    },
    {
      "fieldname": "notification_dispatched",
      "fieldtype": "Check",
      "label": "Notification Dispatched",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "notified_count",
      "fieldtype": "Int",
      "label": "Parties Notified",
      "read_only": 1
    },
    {
      "fieldname": "withdrawn_on",
      "fieldtype": "Date",
      "label": "Withdrawn On"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Enterprise Policy Office",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Policy Owner",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Policy Reviewer",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ]
}

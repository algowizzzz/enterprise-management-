{
  "name": "Governing Document",
  "module": "Policy",
  "description": "The policy repository record. Named Governing Document because it covers Frameworks, Policies, Standards, Procedures and Supporting Documents. The authoritative body and its version chain are held by Core's versioning engine; this record carries the metadata, the lineage and the lifecycle.",
  "autoname": "GDOC-.#####",
  "naming_rule": "Expression (old style)",
  "title_field": "document_name",
  "show_title_field_in_link": 1,
  "search_fields": "document_name,document_type,document_owner",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "allow_rename": 0,
  "fields": [
    {
      "fieldname": "sb_identity",
      "fieldtype": "Section Break",
      "label": "Identity"
    },
    {
      "fieldname": "document_name",
      "fieldtype": "Data",
      "label": "Document Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_type",
      "fieldtype": "Link",
      "label": "Document Type",
      "options": "Governing Document Type",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "document_abstract",
      "fieldtype": "Text",
      "label": "Abstract"
    },
    {
      "fieldname": "direct_document_link",
      "fieldtype": "Data",
      "label": "Direct Document Link"
    },
    {
      "fieldname": "sb_lifecycle",
      "fieldtype": "Section Break",
      "label": "Lifecycle"
    },
    {
      "fieldname": "lifecycle_phase",
      "fieldtype": "Select",
      "label": "Lifecycle Phase",
      "reqd": 1,
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "options": "Draft\nReview\nApproved\nPublished\nImplemented\nRetired",
      "description": "The business-facing phase. Business logic reads the semantic flags below, never this label."
    },
    {
      "fieldname": "workflow_state",
      "fieldtype": "Data",
      "label": "Workflow State",
      "read_only": 1,
      "in_standard_filter": 1,
      "description": "Set by the configured workflow. Configuration, not a logic key."
    },
    {
      "fieldname": "is_editable",
      "fieldtype": "Check",
      "label": "Is Editable",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag set from the configured state. Logic reads this, never the label."
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "requires_review",
      "fieldtype": "Check",
      "label": "Requires Review",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "current_version",
      "fieldtype": "Link",
      "label": "Current Version",
      "options": "Document Version",
      "read_only": 1
    },
    {
      "fieldname": "version_label",
      "fieldtype": "Data",
      "label": "Version",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "body_text",
      "fieldtype": "Long Text",
      "label": "Body Text",
      "read_only": 1,
      "description": "Extracted text of the current version, kept here so repository search covers content as well as title. Never authoritative."
    },
    {
      "fieldname": "sb_accountability",
      "fieldtype": "Section Break",
      "label": "Accountability"
    },
    {
      "fieldname": "document_owner",
      "fieldtype": "Link",
      "label": "Document Owner",
      "options": "User",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "document_approver",
      "fieldtype": "Link",
      "label": "Document Approver",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "document_liaison",
      "fieldtype": "Link",
      "label": "Document Liaison",
      "options": "User"
    },
    {
      "fieldname": "document_delegate",
      "fieldtype": "Link",
      "label": "Document Delegate",
      "options": "User"
    },
    {
      "fieldname": "document_sponsor",
      "fieldtype": "Link",
      "label": "Document Sponsor",
      "options": "User"
    },
    {
      "fieldname": "key_contact",
      "fieldtype": "Link",
      "label": "Key Contact",
      "options": "User"
    },
    {
      "fieldname": "accountability_roles",
      "fieldtype": "Table",
      "label": "Further Accountability Roles",
      "options": "Document Accountability Role"
    },
    {
      "fieldname": "sb_org",
      "fieldtype": "Section Break",
      "label": "Organisational Alignment"
    },
    {
      "fieldname": "owning_operating_group",
      "fieldtype": "Link",
      "label": "Owning Operating Group",
      "options": "Organization Unit",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "owning_line_of_business",
      "fieldtype": "Link",
      "label": "Owning Line of Business",
      "options": "Organization Unit"
    },
    {
      "fieldname": "owning_business_units",
      "fieldtype": "Table MultiSelect",
      "label": "Owning Business Units",
      "options": "Document Organization Unit"
    },
    {
      "fieldname": "legal_entities",
      "fieldtype": "Table MultiSelect",
      "label": "Legal Entities",
      "options": "Document Legal Entity"
    },
    {
      "fieldname": "jurisdictions",
      "fieldtype": "Table MultiSelect",
      "label": "Jurisdictions",
      "options": "Document Jurisdiction"
    },
    {
      "fieldname": "line_of_defence",
      "fieldtype": "Link",
      "label": "Line of Defence",
      "options": "Line Of Defence"
    },
    {
      "fieldname": "sb_risk",
      "fieldtype": "Section Break",
      "label": "Risk Classification"
    },
    {
      "fieldname": "primary_risk_category",
      "fieldtype": "Link",
      "label": "Primary Risk Category",
      "options": "Risk Category",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "risk_types",
      "fieldtype": "Table MultiSelect",
      "label": "Risk Types",
      "options": "Document Risk Type"
    },
    {
      "fieldname": "material_entity_impact",
      "fieldtype": "Check",
      "label": "Material Entity Impact",
      "default": "0"
    },
    {
      "fieldname": "material_entities",
      "fieldtype": "Table MultiSelect",
      "label": "Material Entities",
      "options": "Document Material Entity",
      "depends_on": "material_entity_impact"
    },
    {
      "fieldname": "sb_relationships",
      "fieldtype": "Section Break",
      "label": "Relationships"
    },
    {
      "fieldname": "parent_document",
      "fieldtype": "Link",
      "label": "Parent Document",
      "options": "Governing Document",
      "description": "The document this one sits beneath. A circular chain is refused."
    },
    {
      "fieldname": "relationships",
      "fieldtype": "Table",
      "label": "Relationships",
      "options": "Document Relationship"
    },
    {
      "fieldname": "approving_forum_doctype",
      "fieldtype": "Select",
      "label": "Approving Forum DocType",
      "options": "Governance Forum",
      "default": "Governance Forum",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "approving_forum",
      "fieldtype": "Dynamic Link",
      "label": "Approving Forum",
      "options": "approving_forum_doctype",
      "description": "Held as a dynamic reference so the Policy module installs and migrates independently of the Governance module's build order."
    },
    {
      "fieldname": "superseded_by",
      "fieldtype": "Link",
      "label": "Superseded By",
      "options": "Governing Document"
    },
    {
      "fieldname": "sb_applicability",
      "fieldtype": "Section Break",
      "label": "Applicability"
    },
    {
      "fieldname": "applicability",
      "fieldtype": "Table",
      "label": "Applicability",
      "options": "Document Applicability"
    },
    {
      "fieldname": "sb_regulatory",
      "fieldtype": "Section Break",
      "label": "Regulatory"
    },
    {
      "fieldname": "regulatory_required",
      "fieldtype": "Check",
      "label": "Regulatory Required",
      "default": "0"
    },
    {
      "fieldname": "regulatory_references",
      "fieldtype": "Table",
      "label": "Regulatory References",
      "options": "Document Regulatory Reference",
      "depends_on": "regulatory_required"
    },
    {
      "fieldname": "sb_handling",
      "fieldtype": "Section Break",
      "label": "Control and Handling"
    },
    {
      "fieldname": "confidential",
      "fieldtype": "Check",
      "label": "Confidential",
      "default": "0"
    },
    {
      "fieldname": "handling_classification",
      "fieldtype": "Select",
      "label": "Handling Classification",
      "reqd": 1,
      "default": "Internal",
      "options": "Public\nInternal\nConfidential\nRestricted"
    },
    {
      "fieldname": "allow_download",
      "fieldtype": "Check",
      "label": "Allow Download",
      "default": "1"
    },
    {
      "fieldname": "allow_print",
      "fieldtype": "Check",
      "label": "Allow Print",
      "default": "1"
    },
    {
      "fieldname": "allow_share",
      "fieldtype": "Check",
      "label": "Allow Share",
      "default": "1"
    },
    {
      "fieldname": "training_required",
      "fieldtype": "Check",
      "label": "Training Required",
      "default": "0"
    },
    {
      "fieldname": "sb_dates",
      "fieldtype": "Section Break",
      "label": "Dates"
    },
    {
      "fieldname": "effective_on",
      "fieldtype": "Date",
      "label": "Effective On"
    },
    {
      "fieldname": "next_review_on",
      "fieldtype": "Date",
      "label": "Next Review On"
    },
    {
      "fieldname": "review_frequency_months",
      "fieldtype": "Int",
      "label": "Review Frequency (months)",
      "description": "Drives the next review date and the horizon-scan due date."
    },
    {
      "fieldname": "retired_on",
      "fieldtype": "Date",
      "label": "Retired On",
      "read_only": 1
    },
    {
      "fieldname": "implementation_confirmed_by",
      "fieldtype": "Link",
      "label": "Implementation Confirmed By",
      "options": "User"
    },
    {
      "fieldname": "implementation_confirmed_on",
      "fieldtype": "Date",
      "label": "Implementation Confirmed On"
    },
    {
      "fieldname": "implementation_verified_by",
      "fieldtype": "Link",
      "label": "Implementation Verified By",
      "options": "User"
    },
    {
      "fieldname": "implementation_verified_on",
      "fieldtype": "Date",
      "label": "Implementation Verified On"
    },
    {
      "fieldname": "sb_records",
      "fieldtype": "Section Break",
      "label": "Records"
    },
    {
      "fieldname": "retention_class",
      "fieldtype": "Link",
      "label": "Retention Class",
      "options": "Retention Class"
    },
    {
      "fieldname": "glossary_terms",
      "fieldtype": "Table",
      "label": "Glossary Terms",
      "options": "Glossary Term Link"
    }
  ],
  "permissions": [

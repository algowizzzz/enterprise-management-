{
  "name": "Document Template",
  "module": "Policy",
  "description": "P-15. A template per document type and action, with its predefined sections and its required-field set.",
  "autoname": "field:template_title",
  "allow_rename": 1,
  "title_field": "template_title",
  "search_fields": "template_title,document_type",
  "fields": [
    {
      "fieldname": "template_title",
      "fieldtype": "Data",
      "label": "Template Title",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_type",
      "fieldtype": "Link",
      "label": "Document Type",
      "options": "Governing Document Type",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "action",
      "fieldtype": "Select",
      "label": "Action",
      "options": "New\nEdit\nRetire\nReview",
      "reqd": 1,
      "default": "New",
      "in_list_view": 1
    },
    {
      "fieldname": "template_file",
      "fieldtype": "Attach",
      "label": "Template File"
    },
    {
      "fieldname": "required_fields",
      "fieldtype": "JSON",
      "label": "Required Fields",
      "description": "Field names a document of this type must carry. Read by the metadata maintenance view."
    },
    {
      "fieldname": "naming_convention_pattern",
      "fieldtype": "Data",
      "label": "Naming Convention Pattern"
    },
    {
      "fieldname": "sections",
      "fieldtype": "Table",
      "label": "Sections",
      "options": "Template Section"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Enterprise Policy Office",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Policy Owner",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Policy Reviewer",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ],
  "allow_import": 1
}

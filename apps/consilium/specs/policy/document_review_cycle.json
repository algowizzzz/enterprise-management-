{
  "name": "Document Review Cycle",
  "module": "Policy",
  "description": "Periodic review. Created by cadence or by a horizon scan whose impact assessment triggered one.",
  "autoname": "PRVC-.#####",
  "naming_rule": "Expression (old style)",
  "search_fields": "document,cycle_year",
  "fields": [
    {
      "fieldname": "document",
      "fieldtype": "Link",
      "label": "Document",
      "options": "Governing Document",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "cycle_year",
      "fieldtype": "Data",
      "label": "Cycle",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "scheduled_start",
      "fieldtype": "Date",
      "label": "Scheduled Start"
    },
    {
      "fieldname": "due_on",
      "fieldtype": "Date",
      "label": "Due On",
      "in_list_view": 1
    },
    {
      "fieldname": "reviewer",
      "fieldtype": "Link",
      "label": "Reviewer",
      "options": "User",
      "in_standard_filter": 1
    },
    {
      "fieldname": "cycle_status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Planned",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "options": "Planned\nUnderway\nConcluded\nAbandoned"
    },
    {
      "fieldname": "outcome",
      "fieldtype": "Select",
      "label": "Outcome",
      "options": "\nNo Change\nMinor Update\nMajor Update\nRetire"
    },
    {
      "fieldname": "outcome_notes",
      "fieldtype": "Text",
      "label": "Outcome Notes"
    },
    {
      "fieldname": "resulting_intake_request",
      "fieldtype": "Link",
      "label": "Resulting Intake Request",
      "options": "Document Intake Request"
    },
    {
      "fieldname": "triggered_by_horizon_scan",
      "fieldtype": "Link",
      "label": "Triggered By Horizon Scan",
      "options": "Horizon Scan",
      "read_only": 1
    },
    {
      "fieldname": "sla_clock",
      "fieldtype": "Link",
      "label": "SLA Clock",
      "options": "SLA Clock",
      "read_only": 1
    },
    {
      "fieldname": "is_editable",
      "fieldtype": "Check",
      "label": "Is Editable",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag set from the configured state. Logic reads this, never the label."
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "requires_review",
      "fieldtype": "Check",
      "label": "Requires Review",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "is_open",
      "fieldtype": "Check",
      "label": "Is Open",
      "read_only": 1,
      "default": "1"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Enterprise Policy Office",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Policy Owner",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Policy Reviewer",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ]
}

{
  "name": "Formation Approval Route",
  "module": "Governance",
  "description": "The configurable multi-step approval a committee formation request follows.",
  "autoname": "field:route_title",
  "allow_rename": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "route_title",
  "search_fields": "route_title,request_type,forum_type,change_materiality",
  "fields": [
    {
      "fieldname": "route_title",
      "fieldtype": "Data",
      "label": "Route Title",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "request_type",
      "fieldtype": "Select",
      "label": "Applies To Request Type",
      "options": "Any\nCreate\nModify\nRetire",
      "reqd": 1,
      "default": "Any",
      "in_list_view": 1
    },
    {
      "fieldname": "forum_type",
      "fieldtype": "Link",
      "label": "Applies To Forum Type",
      "options": "Governance Forum Type",
      "in_list_view": 1,
      "description": "Leave empty to apply to every forum type. A route naming the request's forum type is preferred over one that does not."
    },
    {
      "fieldname": "change_materiality",
      "fieldtype": "Select",
      "label": "Applies To Materiality",
      "options": "Any\nMinor\nSignificant\nMaterial",
      "reqd": 1,
      "default": "Any",
      "in_list_view": 1,
      "description": "The materiality of change the request records at intake. A route naming it is preferred over one that applies to any."
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    },
    {
      "fieldname": "steps",
      "fieldtype": "Table",
      "label": "Steps",
      "options": "Formation Approval Route Step",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Risk Governance Office",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "provenance": "02-data-model.md \u00a76; added because the acceptance criterion requires the steps to be configuration rather than code. G-8: the path may differ by forum type and by materiality of change, so a route is keyed by request type, forum type and materiality; the most specific active match wins, most recently modified first among equals"
}

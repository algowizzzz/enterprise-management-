{
  "name": "Periodic Submission",
  "module": "Escalation",
  "description": "A periodic escalation return, including the nil return that confirms no activity.",
  "autoname": "ESPS-.#####",
  "naming_rule": "Expression (old style)",
  "title_field": "period_label",
  "search_fields": "period_label",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Consilium Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Escalation Owner",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "share": 1,
      "email": 1
    },
    {
      "role": "Escalation Reviewer",
      "read": 1,
      "write": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Consilium Audit",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "fields": [
    {
      "fieldname": "period_label",
      "fieldtype": "Data",
      "label": "Period Label",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "period_start",
      "fieldtype": "Date",
      "label": "Period Start",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "period_end",
      "fieldtype": "Date",
      "label": "Period End",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "scope_filter",
      "fieldtype": "JSON",
      "label": "Scope Filter",
      "description": "Stored, not recomputed, so the population that was submitted can be reproduced."
    },
    {
      "fieldname": "submitted_by",
      "fieldtype": "Link",
      "label": "Submitted By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "submitted_on",
      "fieldtype": "Datetime",
      "label": "Submitted On",
      "read_only": 1
    },
    {
      "fieldname": "matter_count",
      "fieldtype": "Int",
      "label": "Matter Count",
      "read_only": 1
    },
    {
      "fieldname": "nil_return",
      "fieldtype": "Check",
      "label": "Nil Return",
      "default": "0",
      "description": "The positive confirmation that there was no activity in the period."
    },
    {
      "fieldname": "report_file",
      "fieldtype": "Attach",
      "label": "Report File"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 1,
      "default": "Draft",
      "in_list_view": 1,
      "options": "Draft\nSubmitted\nAccepted",
      "description": "A label. Business logic reads the semantic flags."
    },
    {
      "fieldname": "is_editable",
      "fieldtype": "Check",
      "label": "Is Editable",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag set from Workflow State Flag on validate. Business logic reads this, never the status label.",
      "provenance": "02-data-model.md M-4"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag set from Workflow State Flag on validate. Business logic reads this, never the status label.",
      "provenance": "02-data-model.md M-4"
    },
    {
      "fieldname": "is_open",
      "fieldtype": "Check",
      "label": "Is Open",
      "read_only": 1,
      "default": "1",
      "description": "Semantic flag set from Workflow State Flag on validate. Business logic reads this, never the status label.",
      "provenance": "02-data-model.md M-4"
    },
    {
      "fieldname": "requires_review",
      "fieldtype": "Check",
      "label": "Requires Review",
      "read_only": 1,
      "default": "0",
      "description": "Semantic flag set from Workflow State Flag on validate. Business logic reads this, never the status label.",
      "provenance": "02-data-model.md M-4"
    },
    {
      "fieldname": "is_committable",
      "fieldtype": "Check",
      "label": "Is Committable",
      "read_only": 1,
      "default": "0",
      "description": "Semantic flag set from Workflow State Flag on validate. Business logic reads this, never the status label.",
      "provenance": "02-data-model.md M-4"
    },
    {
      "fieldname": "requires_statement",
      "fieldtype": "Check",
      "label": "Requires Statement",
      "read_only": 1,
      "default": "0",
      "description": "Semantic flag set from Workflow State Flag on validate. Business logic reads this, never the status label.",
      "provenance": "02-data-model.md M-4"
    }
  ]
}
